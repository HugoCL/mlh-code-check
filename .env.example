# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Next.js app (.env.local / Vercel project settings) ---

# Convex deployment URL (printed by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk keys (Clerk Dashboard > API Keys). Read implicitly by @clerk/nextjs.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Convex deployment variables ---
# These are NOT Next.js variables. Set them in the Convex dashboard
# (Settings > Environment Variables) or with `npx convex env set NAME value`.

# Clerk JWT issuer (Clerk Dashboard > JWT Templates > "convex"),
# e.g. https://<your-clerk-frontend-api>.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Svix signing secret used to verify POST /clerk-webhook requests.
# Get it from Clerk Dashboard > Webhooks > your endpoint > Signing Secret, then:
#   npx convex env set CLERK_WEBHOOK_SECRET whsec_...
# Without it the webhook returns 500 for every event.
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- Trigger.dev tasks (Trigger.dev dashboard > Environment Variables) ---

# Optional GitHub token for higher API rate limits when fetching repositories
GITHUB_TOKEN=ghp_xxx

# The model string "google/gemini-2.5-flash" in trigger/analyze.ts resolves via
# the Vercel AI Gateway, which reads this key implicitly
AI_GATEWAY_API_KEY=xxx
