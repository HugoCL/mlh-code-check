# Next.js app (.env.local)
# Convex deployment URL. `npx convex dev` prints it and writes it to .env.local.
# Trigger.dev tasks also read it, so set it there too.
NEXT_PUBLIC_CONVEX_URL=
# Written by `npx convex dev`. Only needed by the Convex CLI.
CONVEX_DEPLOYMENT=

# Clerk (Next.js middleware, sign-in and sign-up pages)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex dashboard environment variables (not .env.local)
# Frontend API URL of your Clerk instance, e.g. https://<your-instance>.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
# Signing secret used to verify Clerk webhook requests (POST /clerk-webhook).
# Clerk Dashboard > Webhooks > your endpoint > Signing Secret. Set it with:
#   npx convex env set CLERK_WEBHOOK_SECRET whsec_...
# Without it the webhook returns 500 for every event.
CLERK_WEBHOOK_SECRET=

# Trigger.dev
# Used by the server action that starts analyses and creates run tokens.
TRIGGER_SECRET_KEY=

# Trigger.dev project environment variables (set in the Trigger.dev dashboard)
# GitHub token with read access, to raise API rate limits and read private repos.
GITHUB_TOKEN=
# The model is referenced as "google/gemini-2.5-flash" through the Vercel AI SDK,
# which resolves it with the Vercel AI Gateway.
AI_GATEWAY_API_KEY=
